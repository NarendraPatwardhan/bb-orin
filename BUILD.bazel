load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        # nvcc's parser cannot read the hermetic libc++ headers. 13.2's
        # libstdc++ port has an empty c++23 source list under this toolchain;
        # 17.0.0 is the version hermetic-llvm actually builds.
        "@llvm//constraints/cxxstdlib:libstdcxx.17.0.0",
    ],
)

platform(
    name = "rbe",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = {
        "container-image": "docker://ubuntu:22.04",
        "OSFamily": "Linux",
    },
)

rust_binary(
    name = "orin",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = ["@crates//:llama-cpp-2"],
)
