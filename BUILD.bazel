load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        # nvcc 13.2 cannot parse GCC 16+ libstdc++. 13.4 is the newest
        # GCC 13 port, and it does not use those builtins.
        "@llvm//constraints/cxxstdlib:libstdcxx.13.4.0",
    ],
)

platform(
    name = "rbe",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = {
        "container-image": "docker://ubuntu:22.04",
        "OSFamily": "Linux",
    },
)

rust_binary(
    name = "orin",
    srcs = ["src/main.rs"],
    edition = "2024",
    # DT_RPATH applies to libstdc++.so.6's own dependency on libunwind.so.1.
    # DT_RUNPATH would not. The board has no LLVM libunwind.so.1.
    rustc_flags = [
        "-Clink-arg=-Wl,--disable-new-dtags",
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
    ],
    deps = [
        "@crates//:encoding_rs",
        "@crates//:llama-cpp-2",
        "@crates//:llama-cpp-sys-2",
    ],
)

# remote_download_minimal returns only this tar, so the two shared objects
# have to be outputs of the requested target, not runfiles of //:orin.
genrule(
    name = "orin_bundle",
    srcs = [
        ":orin",
        "@llvm//runtimes/libunwind:libunwind.shared",
        "@llvm//runtimes/libstdcxx:libstdcxx.shared",
    ],
    outs = ["orin-bundle.tar"],
    cmd = """\
set -eu
tmp=$$(mktemp -d ./orin-bundle.XXXXXX)
cp -L $(location :orin) $$tmp/orin
chmod 0755 $$tmp/orin
cp -L $(location @llvm//runtimes/libunwind:libunwind.shared) $$tmp/libunwind.so.1
cp -L $(location @llvm//runtimes/libstdcxx:libstdcxx.shared) "$$tmp/libstdc++.so.6"
tar -C $$tmp -cf $@ orin libunwind.so.1 "libstdc++.so.6"
rm -rf $$tmp
""",
)
